@page "/register"
@using System.ComponentModel.DataAnnotations
@inject AuthService Auth
@inject NavigationManager Nav

<div class="auth-container">
    <div class="auth-card fade-in">
        <div class="auth-header">
            <h1 class="auth-logo">🤝 MeetAgain</h1>
            <h2 class="auth-title">Create Your Account</h2>
            <p class="auth-subtitle">Join us and start organizing amazing meetups</p>
        </div>

        @if (!string.IsNullOrEmpty(successMessage))
        {
            <div class="alert alert-success">
                <span class="alert-icon">✅</span>
                <span>@successMessage</span>
            </div>
        }

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-error">
                <span class="alert-icon">⚠️</span>
                <span>@errorMessage</span>
            </div>
        }

        <EditForm Model="@model" OnValidSubmit="HandleRegister" class="auth-form">
            <DataAnnotationsValidator />

            <div class="form-group">
                <label for="displayName">Full Name</label>
                <div class="input-with-icon">
                    <span class="input-icon">👤</span>
                    <InputText id="displayName"
                               @bind-Value="model.DisplayName"
                               class="form-control"
                               placeholder="John Doe" />
                </div>
                <ValidationMessage For="@(() => model.DisplayName)" class="validation-message" />
            </div>

            <div class="form-group">
                <label for="email">Email Address</label>
                <div class="input-with-icon">
                    <span class="input-icon">📧</span>
                    <InputText id="email"
                               @bind-Value="model.Email"
                               class="form-control"
                               placeholder="you@example.com"
                               type="email" />
                </div>
                <ValidationMessage For="@(() => model.Email)" class="validation-message" />
            </div>

            <div class="form-group">
                <label for="password">Password</label>
                <div class="input-with-icon">
                    <span class="input-icon">🔒</span>
                    <InputText id="password"
                               @bind-Value="model.Password"
                               class="form-control"
                               placeholder="At least 6 characters"
                               type="password" />
                </div>
                <ValidationMessage For="@(() => model.Password)" class="validation-message" />
                <p class="input-hint">Must be at least 6 characters long</p>
            </div>

            <div class="form-group">
                <label for="confirmPassword">Confirm Password</label>
                <div class="input-with-icon">
                    <span class="input-icon">🔒</span>
                    <InputText id="confirmPassword"
                               @bind-Value="model.ConfirmPassword"
                               class="form-control"
                               placeholder="Re-enter your password"
                               type="password" />
                </div>
                <ValidationMessage For="@(() => model.ConfirmPassword)" class="validation-message" />
            </div>

            <!-- FIX: Terms/Privacy use @onclick modals, not href="#" -->
            <div class="form-group">
                <label class="checkbox-label">
                    <InputCheckbox @bind-Value="model.AcceptTerms" />
                    <span>
                        I agree to the
                        <button type="button" class="link-text btn-link" @onclick='() => ShowLegal("terms")'>Terms of Service</button>
                        and
                        <button type="button" class="link-text btn-link" @onclick='() => ShowLegal("privacy")'>Privacy Policy</button>
                    </span>
                </label>
                <ValidationMessage For="@(() => model.AcceptTerms)" class="validation-message" />
            </div>

            <button type="submit" class="btn btn-primary btn-lg btn-block" disabled="@isRegistering">
                @if (isRegistering)
                {
                    <span class="loading-spinner" style="width: 1rem; height: 1rem; margin-right: 0.5rem;"></span>
                    <span>Creating Account...</span>
                }
                else
                {
                    <span>Create Account</span>
                }
            </button>
        </EditForm>

        <div class="auth-footer">
            <p>Already have an account?
                <a href="/login" class="link-primary">Sign in</a>
            </p>
        </div>
    </div>
</div>

<!-- Terms / Privacy Modal -->
@if (showLegalModal)
{
    <div class="modal-backdrop" @onclick="HideLegal">
        <div class="modal-card" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3>@(legalPage == "terms" ? "Terms of Service" : "Privacy Policy")</h3>
                <button type="button" class="btn-close" @onclick="HideLegal">×</button>
            </div>
            <div class="modal-body">
                @if (legalPage == "terms")
                {
                    <p>By using MeetAgain, you agree to these terms:</p>
                    <ul style="padding-left: 1.5rem; line-height: 2;">
                        <li>You must be 13 years or older to use this service.</li>
                        <li>You are responsible for activity under your account.</li>
                        <li>Do not use the service for unlawful purposes.</li>
                        <li>We reserve the right to terminate accounts that violate these terms.</li>
                        <li>The service is provided "as is" without warranties of any kind.</li>
                    </ul>
                    <p style="margin-top: 1rem; color: var(--gray-600); font-size: 0.875rem;">
                        Last updated: January 2025
                    </p>
                }
                else
                {
                    <p>We take your privacy seriously. Here's what we collect and why:</p>
                    <ul style="padding-left: 1.5rem; line-height: 2;">
                        <li><strong>Account info:</strong> Name and email to identify you.</li>
                        <li><strong>Meetup data:</strong> Events you create or join.</li>
                        <li><strong>Availability:</strong> Schedule preferences you set.</li>
                        <li>We do not sell your data to third parties.</li>
                        <li>You can request deletion of your account at any time.</li>
                    </ul>
                    <p style="margin-top: 1rem; color: var(--gray-600); font-size: 0.875rem;">
                        Last updated: January 2025
                    </p>
                }
            </div>
            <div style="display: flex; justify-content: flex-end; padding-top: 1rem; border-top: 1px solid var(--gray-200);">
                <button type="button" class="btn btn-primary" @onclick="HideLegal">Got it</button>
            </div>
        </div>
    </div>
}

<style>
    .auth-container {
        min-height: calc(100vh - 200px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem 1rem;
        background: linear-gradient(135deg, rgba(79, 70, 229, 0.05) 0%, rgba(124, 58, 237, 0.05) 100%);
    }

    .auth-card {
        background: white;
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-lg);
        padding: 3rem;
        width: 100%;
        max-width: 450px;
    }

    .auth-header { text-align: center; margin-bottom: 2rem; }
    .auth-logo { font-size: 2.5rem; margin-bottom: 1rem; }

    .auth-title {
        font-size: 1.75rem;
        font-weight: 700;
        color: var(--gray-900);
        margin-bottom: 0.5rem;
    }

    .auth-subtitle { color: var(--gray-600); font-size: 0.95rem; }
    .auth-form { margin-bottom: 1.5rem; }

    .input-with-icon { position: relative; }

    .input-icon {
        position: absolute;
        left: 1rem;
        top: 50%;
        transform: translateY(-50%);
        font-size: 1.125rem;
        pointer-events: none;
    }

    .input-with-icon .form-control { padding-left: 3rem; }

    .input-hint {
        margin-top: 0.25rem;
        font-size: 0.813rem;
        color: var(--gray-600);
    }

    .checkbox-label {
        display: flex;
        align-items: flex-start;
        gap: 0.5rem;
        cursor: pointer;
        color: var(--gray-700);
        font-size: 0.875rem;
        line-height: 1.5;
    }

    .checkbox-label input[type="checkbox"] {
        width: auto;
        cursor: pointer;
        margin-top: 0.25rem;
    }

    /* FIX: Inline link-buttons that look like anchor tags */
    .btn-link {
        background: none;
        border: none;
        padding: 0;
        cursor: pointer;
        font-size: inherit;
        display: inline;
    }

    .link-text {
        color: var(--primary);
        text-decoration: none;
        font-weight: 500;
    }

    .link-text:hover { text-decoration: underline; }

    .btn-block { width: 100%; }

    .auth-footer {
        text-align: center;
        padding-top: 1.5rem;
        border-top: 1px solid var(--gray-200);
        color: var(--gray-600);
    }

    .link-primary {
        color: var(--primary);
        text-decoration: none;
        font-weight: 600;
    }

    .link-primary:hover { text-decoration: underline; }

    .alert {
        padding: 1rem;
        border-radius: var(--radius);
        margin-bottom: 1.5rem;
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .alert-success {
        background: #D1FAE5;
        color: #065F46;
        border-left: 4px solid var(--success);
    }

    .alert-error {
        background: #FEE2E2;
        color: #991B1B;
        border-left: 4px solid var(--danger);
    }

    .alert-icon { font-size: 1.25rem; }

    /* Modal */
    .modal-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.5);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 9999;
        padding: 1rem;
    }

    .modal-card {
        background: white;
        border-radius: var(--radius-lg);
        padding: 2rem;
        width: 100%;
        max-width: 500px;
        max-height: 80vh;
        display: flex;
        flex-direction: column;
        box-shadow: var(--shadow-lg);
    }

    .modal-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1rem;
        flex-shrink: 0;
    }

    .modal-header h3 {
        font-size: 1.25rem;
        font-weight: 700;
        color: var(--gray-900);
        margin: 0;
    }

    .modal-body {
        overflow-y: auto;
        flex: 1;
        line-height: 1.7;
        color: var(--gray-700);
        padding-right: 0.25rem;
    }

    .btn-close {
        background: none;
        border: none;
        font-size: 1.5rem;
        cursor: pointer;
        color: var(--gray-500);
        line-height: 1;
        padding: 0;
    }

    .btn-close:hover { color: var(--gray-900); }

    @@media (max-width: 640px) {
        .auth-card { padding: 2rem 1.5rem; }
        .auth-title { font-size: 1.5rem; }
    }
</style>

@code {
    private RegisterModel model = new();
    private string errorMessage = "";
    private string successMessage = "";
    private bool isRegistering = false;

    // Legal modal state
    private bool showLegalModal = false;
    private string legalPage = "terms";

    private void ShowLegal(string page)
    {
        legalPage = page;
        showLegalModal = true;
    }

    private void HideLegal()
    {
        showLegalModal = false;
    }

    private async Task HandleRegister()
    {
        try
        {
            isRegistering = true;
            errorMessage = "";
            successMessage = "";

            if (model.Password != model.ConfirmPassword)
            {
                errorMessage = "Passwords do not match.";
                return;
            }

            var success = await Auth.SignUpAsync(model.Email, model.Password, model.DisplayName);

            if (success)
            {
                successMessage = "Account created successfully! Redirecting to login...";
                await Task.Delay(1500);
                Nav.NavigateTo("/login");
            }
            else
            {
                errorMessage = Auth.LastFirebaseError ?? "Registration failed. Please try again.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = "An error occurred during registration. Please try again.";
            Console.WriteLine($"Registration error: {ex.Message}");
        }
        finally
        {
            isRegistering = false;
        }
    }

    public class RegisterModel
    {
        [Required(ErrorMessage = "Full name is required")]
        [MinLength(2, ErrorMessage = "Name must be at least 2 characters")]
        public string DisplayName { get; set; } = "";

        [Required(ErrorMessage = "Email is required")]
        [EmailAddress(ErrorMessage = "Invalid email address")]
        public string Email { get; set; } = "";

        [Required(ErrorMessage = "Password is required")]
        [MinLength(6, ErrorMessage = "Password must be at least 6 characters")]
        public string Password { get; set; } = "";

        [Required(ErrorMessage = "Please confirm your password")]
        [Compare(nameof(Password), ErrorMessage = "Passwords do not match")]
        public string ConfirmPassword { get; set; } = "";

        [Range(typeof(bool), "true", "true", ErrorMessage = "You must accept the terms and conditions")]
        public bool AcceptTerms { get; set; } = false;
    }
}
