@page "/login"
@using System.ComponentModel.DataAnnotations
@inject AuthService Auth
@inject NavigationManager Nav

<div class="auth-container">
    <div class="auth-card fade-in">
        <div class="auth-header">
            <h1 class="auth-logo">🤝 MeetAgain</h1>
            <h2 class="auth-title">Welcome Back</h2>
            <p class="auth-subtitle">Sign in to continue organizing your meetups</p>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-error">
                <span class="alert-icon">⚠️</span>
                <span>@errorMessage</span>
            </div>
        }

        @if (!string.IsNullOrEmpty(successMessage))
        {
            <div class="alert alert-success">
                <span class="alert-icon">✅</span>
                <span>@successMessage</span>
            </div>
        }

        <EditForm Model="@model" OnValidSubmit="HandleLogin" class="auth-form">
            <DataAnnotationsValidator />

            <div class="form-group">
                <label for="email">Email Address</label>
                <div class="input-with-icon">
                    <span class="input-icon">📧</span>
                    <InputText id="email"
                               @bind-Value="model.Email"
                               class="form-control"
                               placeholder="you@example.com"
                               type="email" />
                </div>
                <ValidationMessage For="@(() => model.Email)" class="validation-message" />
            </div>

            <div class="form-group">
                <label for="password">Password</label>
                <div class="input-with-icon">
                    <span class="input-icon">🔒</span>
                    <InputText id="password"
                               @bind-Value="model.Password"
                               class="form-control"
                               placeholder="Enter your password"
                               type="password" />
                </div>
                <ValidationMessage For="@(() => model.Password)" class="validation-message" />
            </div>

            <div class="form-extras">
                <label class="checkbox-label">
                    <input type="checkbox" @bind="rememberMe" />
                    <span>Remember me</span>
                </label>
                <button type="button" class="link-text btn-link" @onclick="ShowForgotPassword">
                    Forgot password?
                </button>
            </div>

            <button type="submit" class="btn btn-primary btn-lg btn-block" disabled="@isLoggingIn">
                @if (isLoggingIn)
                {
                    <span class="loading-spinner" style="width: 1rem; height: 1rem; margin-right: 0.5rem;"></span>
                    <span>Signing in...</span>
                }
                else
                {
                    <span>Sign In</span>
                }
            </button>
        </EditForm>

        <div class="auth-footer">
            <p>Don't have an account?
                <a href="/register" class="link-primary">Sign up</a>
            </p>
        </div>
    </div>
</div>

<!-- Forgot Password Modal -->
@if (showForgotPassword)
{
    <div class="modal-backdrop" @onclick="HideForgotPassword">
        <div class="modal-card" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3>Reset Password</h3>
                <button type="button" class="btn-close" @onclick="HideForgotPassword">×</button>
            </div>

            @if (!string.IsNullOrEmpty(resetMessage))
            {
                <div class="alert @(resetSuccess ? "alert-success" : "alert-error")" style="margin-bottom: 1rem;">
                    <span class="alert-icon">@(resetSuccess ? "✅" : "⚠️")</span>
                    <span>@resetMessage</span>
                </div>
            }

            <p style="color: var(--gray-600); margin-bottom: 1.25rem; font-size: 0.9rem;">
                Enter your email address and we'll send you a link to reset your password.
            </p>

            <div class="form-group" style="margin-bottom: 1.25rem;">
                <label for="resetEmail">Email Address</label>
                <div class="input-with-icon">
                    <span class="input-icon">📧</span>
                    <input id="resetEmail"
                           type="email"
                           class="form-control"
                           placeholder="you@example.com"
                           @bind="resetEmail"
                           @bind:event="oninput" />
                </div>
            </div>

            <div style="display: flex; gap: 0.75rem; justify-content: flex-end;">
                <button type="button" class="btn btn-outline" @onclick="HideForgotPassword">
                    Cancel
                </button>
                <button type="button" class="btn btn-primary" @onclick="HandleForgotPassword" disabled="@isSendingReset">
                    @if (isSendingReset)
                    {
                        <span class="loading-spinner" style="width: 1rem; height: 1rem; margin-right: 0.5rem;"></span>
                        <span>Sending...</span>
                    }
                    else
                    {
                        <span>Send Reset Link</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<style>
    .auth-container {
        min-height: calc(100vh - 200px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem 1rem;
        background: linear-gradient(135deg, rgba(79, 70, 229, 0.05) 0%, rgba(124, 58, 237, 0.05) 100%);
    }

    .auth-card {
        background: white;
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-lg);
        padding: 3rem;
        width: 100%;
        max-width: 450px;
    }

    .auth-header {
        text-align: center;
        margin-bottom: 2rem;
    }

    .auth-logo { font-size: 2.5rem; margin-bottom: 1rem; }

    .auth-title {
        font-size: 1.75rem;
        font-weight: 700;
        color: var(--gray-900);
        margin-bottom: 0.5rem;
    }

    .auth-subtitle { color: var(--gray-600); font-size: 0.95rem; }

    .auth-form { margin-bottom: 1.5rem; }

    .input-with-icon { position: relative; }

    .input-icon {
        position: absolute;
        left: 1rem;
        top: 50%;
        transform: translateY(-50%);
        font-size: 1.125rem;
        pointer-events: none;
    }

    .input-with-icon .form-control { padding-left: 3rem; }

    .form-extras {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
        font-size: 0.875rem;
    }

    .checkbox-label {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        cursor: pointer;
        color: var(--gray-700);
    }

    .checkbox-label input[type="checkbox"] { width: auto; cursor: pointer; }

    .btn-link {
        background: none;
        border: none;
        padding: 0;
        cursor: pointer;
        font-size: inherit;
    }

    .link-text {
        color: var(--primary);
        text-decoration: none;
        font-weight: 500;
    }

    .link-text:hover { text-decoration: underline; }

    .btn-block { width: 100%; }

    .auth-footer {
        text-align: center;
        padding-top: 1.5rem;
        border-top: 1px solid var(--gray-200);
        color: var(--gray-600);
    }

    .link-primary {
        color: var(--primary);
        text-decoration: none;
        font-weight: 600;
    }

    .link-primary:hover { text-decoration: underline; }

    .alert {
        padding: 1rem;
        border-radius: var(--radius);
        margin-bottom: 1.5rem;
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .alert-error {
        background: #FEE2E2;
        color: #991B1B;
        border-left: 4px solid var(--danger);
    }

    .alert-success {
        background: #D1FAE5;
        color: #065F46;
        border-left: 4px solid var(--success);
    }

    .alert-icon { font-size: 1.25rem; }

    .modal-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.5);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 9999;
        padding: 1rem;
    }

    .modal-card {
        background: white;
        border-radius: var(--radius-lg);
        padding: 2rem;
        width: 100%;
        max-width: 420px;
        box-shadow: var(--shadow-lg);
    }

    .modal-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1rem;
    }

    .modal-header h3 {
        font-size: 1.25rem;
        font-weight: 700;
        color: var(--gray-900);
        margin: 0;
    }

    .btn-close {
        background: none;
        border: none;
        font-size: 1.5rem;
        cursor: pointer;
        color: var(--gray-500);
        line-height: 1;
        padding: 0;
    }

    .btn-close:hover { color: var(--gray-900); }

    @@media (max-width: 640px) {
        .auth-card { padding: 2rem 1.5rem; }
        .auth-title { font-size: 1.5rem; }
    }
</style>

@code {
    private LoginModel model = new();
    private string errorMessage  = "";
    private string successMessage = "";
    private bool   isLoggingIn   = false;
    private bool   rememberMe    = false;   // bound to the checkbox

    // Forgot password state
    private bool   showForgotPassword = false;
    private string resetEmail         = "";
    private string resetMessage       = "";
    private bool   resetSuccess       = false;
    private bool   isSendingReset     = false;

    private async Task HandleLogin()
    {
        isLoggingIn  = true;
        errorMessage = "";

        try
        {
            // ✅ THE FIX: pass rememberMe so the token goes to the right store
            var success = await Auth.LoginAsync(model.Email, model.Password, rememberMe);

            if (success)
            {
                Nav.NavigateTo("/dashboard");
            }
            else
            {
                errorMessage = Auth.LastFirebaseError ?? "Invalid email or password. Please try again.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = "An error occurred during login. Please try again.";
            Console.WriteLine($"Login error: {ex.Message}");
        }
        finally
        {
            isLoggingIn = false;
        }
    }

    private void ShowForgotPassword()
    {
        resetEmail   = model.Email; // pre-fill with whatever they typed
        resetMessage = "";
        resetSuccess = false;
        showForgotPassword = true;
    }

    private void HideForgotPassword()
    {
        showForgotPassword = false;
        resetMessage = "";
        resetEmail   = "";
    }

    private async Task HandleForgotPassword()
    {
        if (string.IsNullOrWhiteSpace(resetEmail))
        {
            resetMessage = "Please enter your email address.";
            resetSuccess = false;
            return;
        }

        isSendingReset = true;
        resetMessage   = "";

        try
        {
            var sent = await Auth.SendPasswordResetEmailAsync(resetEmail.Trim());

            if (sent)
            {
                resetMessage = $"Password reset link sent to {resetEmail}. Check your inbox (and spam folder).";
                resetSuccess = true;
            }
            else
            {
                resetMessage = Auth.LastFirebaseError ?? "Could not send reset email. Please check the address and try again.";
                resetSuccess = false;
            }
        }
        catch (Exception ex)
        {
            resetMessage = "An error occurred. Please try again.";
            resetSuccess = false;
            Console.WriteLine($"Password reset error: {ex.Message}");
        }
        finally
        {
            isSendingReset = false;
        }
    }

    public class LoginModel
    {
        [Required(ErrorMessage = "Email is required")]
        [EmailAddress(ErrorMessage = "Invalid email address")]
        public string Email { get; set; } = "";

        [Required(ErrorMessage = "Password is required")]
        [MinLength(6, ErrorMessage = "Password must be at least 6 characters")]
        public string Password { get; set; } = "";
    }
}
