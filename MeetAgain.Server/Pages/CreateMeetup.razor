@page "/create-meetup"
@inject MeetupService MeetupService
@inject FriendService FriendService
@inject GroupService GroupService
@inject AvailabilityService AvailabilityService
@inject NotificationService NotificationService
@inject AuthService Auth
@inject NavigationManager Nav

<div class="max-w-4xl mx-auto">
    <div class="card fade-in">
        <div class="card-header">
            <h2 class="card-title">Create New Meetup</h2>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-error">
                ⚠️ @errorMessage
            </div>
        }

        <EditForm Model="@model" OnValidSubmit="HandleCreate">
            <DataAnnotationsValidator />
            <ValidationSummary class="validation-summary" />

            <div class="form-group">
                <label>Title *</label>
                <InputText @bind-Value="model.Title" 
                           class="form-control" 
                           placeholder="e.g., Coffee Meetup, Game Night, Study Session" />
                <ValidationMessage For="@(() => model.Title)" class="validation-message" />
            </div>

            <div class="form-group">
                <label>Description *</label>
                <InputTextArea @bind-Value="model.Description" 
                               class="form-control" 
                               placeholder="What's this meetup about? Add any details participants should know..."
                               rows="4" />
                <ValidationMessage For="@(() => model.Description)" class="validation-message" />
            </div>

            <!-- Invite Groups & Friends Section -->
            @if (isLoadingFriends)
            {
                <div style="padding: 1rem; text-align: center; color: var(--gray-600);">
                    <span class="loading-spinner" style="width: 1rem; height: 1rem; margin-right: 0.5rem;"></span>
                    Loading groups and friends...
                </div>
            }
            else if (groups.Count > 0 || friends.Count > 0)
            {
                <!-- Groups Section -->
                @if (groups.Count > 0)
                {
                    <div class="form-group">
                        <label style="display: flex; align-items: center; justify-content: space-between;">
                            <span>👥 Invite Groups (Optional)</span>
                            <small style="color: var(--gray-600); font-weight: normal;">
                                @selectedGroupIds.Count selected
                            </small>
                        </label>
                        <div class="friends-selector">
                            @foreach (var group in groups)
                            {
                                <div class="friend-checkbox-item">
                                    <label style="display: flex; align-items: center; cursor: pointer; margin: 0; width: 100%;">
                                        <input type="checkbox" 
                                               checked="@selectedGroupIds.Contains(group.Id)"
                                               @onchange="@(e => ToggleGroupSelection(group.Id, e))"
                                               style="margin-right: 0.75rem; cursor: pointer;" />
                                        <div style="display: flex; align-items: center; flex: 1;">
                                            <div class="friend-avatar-small" style="background: var(--success);">
                                                @GetGroupInitials(group.Name)
                                            </div>
                                            <div style="margin-left: 0.75rem; flex: 1; min-width: 0;">
                                                <div style="font-weight: 600; color: var(--gray-900); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                                    @group.Name
                                                </div>
                                                <div style="font-size: 0.875rem; color: var(--gray-600);">
                                                    @group.MemberCount member@(group.MemberCount != 1 ? "s" : "")
                                                </div>
                                            </div>
                                        </div>
                                    </label>
                                </div>
                            }
                        </div>
                    </div>
                }

                <!-- Friends Section -->
                @if (friends.Count > 0)
                {
                    <div class="form-group">
                        <label style="display: flex; align-items: center; justify-content: space-between;">
                            <span>👥 Invite Friends (Optional)</span>
                            <small style="color: var(--gray-600); font-weight: normal;">
                                @selectedFriendIds.Count selected
                            </small>
                        </label>
                        <div class="friends-selector">
                            @foreach (var friend in friends)
                            {
                                <div class="friend-checkbox-item">
                                    <label style="display: flex; align-items: center; cursor: pointer; margin: 0; width: 100%;">
                                        <input type="checkbox" 
                                               checked="@selectedFriendIds.Contains(friend.Id)"
                                               @onchange="@(e => ToggleFriendSelection(friend.Id, e))"
                                               style="margin-right: 0.75rem; cursor: pointer;" />
                                        <div style="display: flex; align-items: center; flex: 1;">
                                            <div class="friend-avatar-small">
                                                @GetInitials(friend.Name)
                                            </div>
                                            <div style="margin-left: 0.75rem; flex: 1; min-width: 0;">
                                                <div style="font-weight: 600; color: var(--gray-900); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                                    @friend.Name
                                                </div>
                                                <div style="font-size: 0.875rem; color: var(--gray-600); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                                    @friend.Email
                                                </div>
                                            </div>
                                        </div>
                                    </label>
                                </div>
                            }
                        </div>
                        @if (friends.Count > 3)
                        {
                            <div style="margin-top: 0.5rem; text-align: right;">
                                <button type="button" 
                                        class="btn btn-outline btn-sm"
                                        @onclick="ToggleSelectAll">
                                    @(selectedFriendIds.Count == friends.Count ? "Deselect All" : "Select All")
                                </button>
                            </div>
                        }
                    </div>
                }
            }
            else
            {
                <div style="background: var(--gray-50); padding: 1rem; border-radius: var(--radius); margin-bottom: 1.5rem; text-align: center;">
                    <p style="color: var(--gray-600); margin: 0;">
                        👥 No friends or groups yet. <a href="/friends" style="color: var(--primary); text-decoration: none; font-weight: 600;">Add friends</a> or <a href="/groups" style="color: var(--primary); text-decoration: none; font-weight: 600;">create groups</a> to invite them!
                    </p>
                </div>
            }

            <!-- Smart Availability Section -->
            @if (GetAllSelectedParticipants().Count > 0)
            {
                <div class="smart-suggestions-card">
                    <div class="smart-suggestions-header">
                        <h3 style="margin: 0; display: flex; align-items: center; gap: 0.5rem;">
                            💡 Smart Time Suggestions
                        </h3>
                        <button type="button" 
                                class="btn btn-primary btn-sm" 
                                @onclick="FindBestTimes" 
                                disabled="@isFindingTimes">
                            @if (isFindingTimes)
                            {
                                <span class="loading-spinner" style="width: 0.875rem; height: 0.875rem; margin-right: 0.5rem;"></span>
                            }
                            🔍 Find Best Times
                        </button>
                    </div>

                    @if (!suggestedTimes.Any() && !isFindingTimes)
                    {
                        <p style="color: var(--gray-600); margin: 0.75rem 0 0 0;">
                            💡 Click "Find Best Times" to get AI-powered suggestions based on everyone's availability!
                            <br><small style="color: var(--gray-500); margin-top: 0.5rem; display: block;">
                                Tip: Even without set preferences, the system will suggest optimal times based on typical working hours.
                            </small>
                        </p>
                    }
                    else if (isFindingTimes)
                    {
                        <div style="text-align: center; padding: 2rem 0;">
                            <div class="loading-spinner" style="width: 2rem; height: 2rem; margin: 0 auto 1rem;"></div>
                            <p style="color: var(--gray-600); margin: 0;">Analyzing availability patterns...</p>
                        </div>
                    }
                    else if (suggestedTimes.Any())
                    {
                        <div style="margin-top: 1rem;">
                            <p style="color: var(--success); font-weight: 600; margin-bottom: 1rem;">
                                ✅ Here are the best times based on everyone's availability:
                            </p>
                            
                            <div class="suggestions-list">
                                @foreach (var suggestion in suggestedTimes)
                                {
                                    <div class="suggestion-item @(selectedSuggestion == suggestion ? "selected" : "")"
                                         @onclick="() => SelectSuggestion(suggestion)">
                                        <div class="suggestion-content">
                                            <div>
                                                <div style="font-weight: 600; color: var(--gray-900); margin-bottom: 0.25rem;">
                                                    @suggestion.StartTime.ToString("dddd, MMMM dd")
                                                </div>
                                                <div style="color: var(--gray-600);">
                                                    @suggestion.StartTime.ToString("h:mm tt") - @suggestion.EndTime.ToString("h:mm tt")
                                                </div>
                                            </div>
                                            <div class="suggestion-badge">
                                                <span class="availability-badge @GetAvailabilityBadgeClass(suggestion.AvailabilityScore)">
                                                    @suggestion.AvailabilityScore.ToString("F0")%
                                                </span>
                                                <div style="font-size: 0.75rem; color: var(--gray-600); margin-top: 0.25rem;">
                                                    @suggestion.AvailableParticipants/@suggestion.TotalParticipants available
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>

                            <div style="background: var(--gray-50); padding: 0.75rem; border-radius: var(--radius); margin-top: 1rem;">
                                <small style="color: var(--gray-600);">
                                    💡 Or manually set date and time below
                                </small>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div style="margin-top: 1rem; padding: 1rem; background: var(--warning); background: #FEF3C7; border-radius: var(--radius);">
                            <p style="color: #92400E; margin: 0; font-weight: 600;">
                                ⚠️ No optimal times found
                            </p>
                            <p style="color: #92400E; margin: 0.5rem 0 0 0; font-size: 0.875rem;">
                                Try adjusting your date range or manually set a time below. You can also ask participants to update their availability settings.
                            </p>
                        </div>
                    }
                </div>
            }

            <div class="form-row">
                <div class="form-group">
                    <label>Date *</label>
                    <InputDate @bind-Value="model.Date" class="form-control" />
                    <ValidationMessage For="@(() => model.Date)" class="validation-message" />
                </div>

                <div class="form-group">
                    <label>Time *</label>
                    <input type="time" 
                           class="form-control" 
                           value="@timeString" 
                           @onchange="OnTimeChanged" />
                </div>
            </div>

            <div class="preview-section">
                <h3 class="preview-title">📋 Preview</h3>
                <div class="meetup-preview">
                    <div class="preview-header">
                        <strong>@(string.IsNullOrWhiteSpace(model.Title) ? "Meetup Title" : model.Title)</strong>
                    </div>
                    <p class="preview-description">
                        @(string.IsNullOrWhiteSpace(model.Description) ? "Meetup description will appear here..." : model.Description)
                    </p>
                    <div class="preview-datetime">
                        📅 @model.Date.ToString("MMMM dd, yyyy") at @timeString
                    </div>
                    @if (selectedGroupIds.Count > 0 || selectedFriendIds.Count > 0)
                    {
                        <div style="margin-top: 1rem; padding-top: 1rem; border-top: 1px solid var(--gray-200);">
                            <div style="font-weight: 600; color: var(--gray-700); margin-bottom: 0.5rem;">
                                👥 Inviting:
                            </div>
                            
                            @if (selectedGroupIds.Count > 0)
                            {
                                <div style="margin-bottom: 0.5rem;">
                                    <strong style="color: var(--success);">Groups (@selectedGroupIds.Count):</strong>
                                    <div style="display: flex; gap: 0.5rem; flex-wrap: wrap; margin-top: 0.25rem;">
                                        @foreach (var groupId in selectedGroupIds)
                                        {
                                            var group = groups.FirstOrDefault(g => g.Id == groupId);
                                            if (group != null)
                                            {
                                                <span class="friend-tag" style="background: var(--success);">
                                                    @group.Name (@group.MemberCount)
                                                </span>
                                            }
                                        }
                                    </div>
                                </div>
                            }
                            
                            @if (selectedFriendIds.Count > 0)
                            {
                                <div>
                                    <strong style="color: var(--primary);">Individual Friends (@selectedFriendIds.Count):</strong>
                                    <div style="display: flex; gap: 0.5rem; flex-wrap: wrap; margin-top: 0.25rem;">
                                        @foreach (var friendId in selectedFriendIds)
                                        {
                                            var friend = friends.FirstOrDefault(f => f.Id == friendId);
                                            if (friend != null)
                                            {
                                                <span class="friend-tag">@friend.Name</span>
                                            }
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary btn-lg" disabled="@isSubmitting">
                    @if (isSubmitting)
                    {
                        <span class="loading-spinner" style="width: 1rem; height: 1rem; margin-right: 0.5rem;"></span>
                        <span>Creating...</span>
                    }
                    else
                    {
                        <span>✨ Create Meetup</span>
                    }
                </button>
                <a href="/dashboard" class="btn btn-outline">
                    Cancel
                </a>
            </div>
        </EditForm>
    </div>
</div>

<style>
    .alert {
        padding: 1rem;
        border-radius: var(--radius);
        margin-bottom: 1.5rem;
    }

    .alert-error {
        background: #FEE2E2;
        color: #991B1B;
        border-left: 4px solid var(--danger);
    }

    .validation-summary {
        background: #FEF2F2;
        border: 1px solid #FECACA;
        border-radius: var(--radius);
        padding: 1rem;
        margin-bottom: 1.5rem;
        color: var(--danger);
    }

    .validation-message {
        color: var(--danger);
        font-size: 0.875rem;
        margin-top: 0.25rem;
        display: block;
    }

    .form-control {
        width: 100%;
        padding: 0.75rem;
        border: 2px solid var(--gray-200);
        border-radius: var(--radius);
        font-size: 1rem;
        transition: all 0.2s ease;
    }

    .form-control:focus {
        outline: none;
        border-color: var(--primary);
        box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.1);
    }

    .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
    }

    .friends-selector {
        max-height: 300px;
        overflow-y: auto;
        border: 2px solid var(--gray-200);
        border-radius: var(--radius);
        padding: 0.5rem;
        background: white;
    }

    .friend-checkbox-item {
        padding: 0.75rem;
        border-radius: var(--radius);
        transition: background 0.2s;
    }

    .friend-checkbox-item:hover {
        background: var(--gray-50);
    }

    .friend-avatar-small {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: var(--primary);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 600;
        font-size: 0.875rem;
        flex-shrink: 0;
    }

    .friend-tag {
        background: var(--primary);
        color: white;
        padding: 0.25rem 0.75rem;
        border-radius: 1rem;
        font-size: 0.875rem;
        font-weight: 500;
    }

    .preview-section {
        background: var(--gray-50);
        padding: 1.5rem;
        border-radius: var(--radius);
        margin-bottom: 1.5rem;
    }

    .preview-title {
        font-size: 1rem;
        font-weight: 600;
        color: var(--gray-700);
        margin-bottom: 1rem;
    }

    .meetup-preview {
        background: white;
        padding: 1.5rem;
        border-radius: var(--radius);
        border: 2px solid var(--gray-200);
    }

    .preview-header {
        font-size: 1.25rem;
        font-weight: 700;
        color: var(--gray-900);
        margin-bottom: 0.75rem;
    }

    .preview-description {
        color: var(--gray-600);
        line-height: 1.6;
        margin-bottom: 1rem;
    }

    .preview-datetime {
        color: var(--primary);
        font-weight: 600;
        font-size: 0.875rem;
    }

    .form-actions {
        display: flex;
        gap: 1rem;
        justify-content: flex-start;
    }

    /* Smart Suggestions Styles */
    .smart-suggestions-card {
        background: linear-gradient(135deg, #EEF2FF 0%, #E0E7FF 100%);
        border: 2px solid var(--primary-light);
        border-radius: var(--radius-lg);
        padding: 1.5rem;
        margin-bottom: 1.5rem;
    }

    .smart-suggestions-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 0.75rem;
    }

    .suggestions-list {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .suggestion-item {
        background: white;
        border: 2px solid var(--gray-200);
        border-radius: var(--radius);
        padding: 1rem;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .suggestion-item:hover {
        border-color: var(--primary);
        transform: translateX(4px);
    }

    .suggestion-item.selected {
        background: var(--primary);
        border-color: var(--primary);
        color: white;
    }

    .suggestion-item.selected * {
        color: white !important;
    }

    .suggestion-content {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .suggestion-badge {
        text-align: right;
    }

    .availability-badge {
        display: inline-block;
        padding: 0.25rem 0.75rem;
        border-radius: 1rem;
        font-weight: 600;
        font-size: 0.875rem;
    }

    .availability-badge.high {
        background: var(--success);
        color: white;
    }

    .availability-badge.medium {
        background: var(--warning);
        color: var(--gray-900);
    }

    .availability-badge.low {
        background: var(--danger);
        color: white;
    }

    @@media (max-width: 768px) {
        .form-row {
            grid-template-columns: 1fr;
        }

        .smart-suggestions-header {
            flex-direction: column;
            gap: 0.75rem;
            align-items: stretch;
        }

        .suggestion-content {
            flex-direction: column;
            gap: 0.75rem;
            align-items: flex-start;
        }

        .suggestion-badge {
            text-align: left;
        }
    }
</style>

@code {
    private CreateMeetupModel model = new();
    private string timeString = "12:00";
    private string errorMessage = "";
    private bool isSubmitting = false;
    private bool isLoadingFriends = true;
    private List<Friend> friends = new();
    private List<GroupDto> groups = new();
    private HashSet<string> selectedFriendIds = new();
    private HashSet<string> selectedGroupIds = new();
    
    // Smart availability fields
    private bool isFindingTimes = false;
    private List<SuggestedTimeSlot> suggestedTimes = new();
    private SuggestedTimeSlot? selectedSuggestion = null;

    protected override async Task OnInitializedAsync()
    {
        model.Date = DateTime.Today.AddDays(1);
        timeString = "12:00";
        UpdateModelTime();
        
        // Load friends and groups
        try
        {
            var friendsTask = FriendService.GetFriendsAsync();
            var groupsTask = GroupService.GetMyGroupsAsync();
            
            await Task.WhenAll(friendsTask, groupsTask);
            
            friends = await friendsTask;
            groups = await groupsTask;
            
            Console.WriteLine($"Loaded {friends.Count} friends and {groups.Count} groups for invite");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading friends/groups: {ex.Message}");
        }
        finally
        {
            isLoadingFriends = false;
        }
    }

    private void OnTimeChanged(ChangeEventArgs e)
    {
        timeString = e.Value?.ToString() ?? "12:00";
        UpdateModelTime();
    }

    private void UpdateModelTime()
    {
        if (TimeOnly.TryParse(timeString, out var t))
            model.Time = t;
    }

    private void ToggleFriendSelection(string friendId, ChangeEventArgs e)
    {
        var isChecked = (bool)(e.Value ?? false);
        if (isChecked)
        {
            selectedFriendIds.Add(friendId);
            Console.WriteLine($"Selected friend: {friendId}");
        }
        else
        {
            selectedFriendIds.Remove(friendId);
            Console.WriteLine($"Deselected friend: {friendId}");
        }
        
        // Clear suggestions when selection changes
        suggestedTimes.Clear();
        selectedSuggestion = null;
    }

    private void ToggleGroupSelection(string groupId, ChangeEventArgs e)
    {
        var isChecked = (bool)(e.Value ?? false);
        if (isChecked)
        {
            selectedGroupIds.Add(groupId);
            Console.WriteLine($"Selected group: {groupId}");
        }
        else
        {
            selectedGroupIds.Remove(groupId);
            Console.WriteLine($"Deselected group: {groupId}");
        }
        
        // Clear suggestions when selection changes
        suggestedTimes.Clear();
        selectedSuggestion = null;
    }

    private void ToggleSelectAll()
    {
        if (selectedFriendIds.Count == friends.Count)
        {
            selectedFriendIds.Clear();
            Console.WriteLine("Deselected all friends");
        }
        else
        {
            selectedFriendIds = friends.Select(f => f.Id).ToHashSet();
            Console.WriteLine($"Selected all {friends.Count} friends");
        }
        
        suggestedTimes.Clear();
        selectedSuggestion = null;
    }

    // Get all unique participants from both friends and groups
    private List<string> GetAllSelectedParticipants()
    {
        var allParticipants = new HashSet<string>(selectedFriendIds);
        
        foreach (var groupId in selectedGroupIds)
        {
            var group = groups.FirstOrDefault(g => g.Id == groupId);
            if (group != null)
            {
                foreach (var member in group.Members)
                {
                    allParticipants.Add(member.UserId);
                }
            }
        }
        
        return allParticipants.ToList();
    }

    // Find best times using availability algorithm
    private async Task FindBestTimes()
    {
        isFindingTimes = true;
        suggestedTimes.Clear();
        errorMessage = "";
        
        try
        {
            var allParticipants = GetAllSelectedParticipants();
            Console.WriteLine($"Finding best times for {allParticipants.Count} participants");
            
            if (allParticipants.Count == 0)
            {
                errorMessage = "Please select at least one friend or group to get time suggestions.";
                return;
            }
            
            var startDate = DateTime.Today;
            var endDate = DateTime.Today.AddDays(14); // Look ahead 2 weeks
            
            suggestedTimes = await AvailabilityService.FindBestMeetupTimesAsync(
                allParticipants,
                startDate,
                endDate,
                120, // 2 hour duration
                5 // top 5 suggestions
            );
            
            Console.WriteLine($"Found {suggestedTimes.Count} suggestions");
            
            if (suggestedTimes.Count == 0)
            {
                errorMessage = "No optimal times found. Try selecting different dates or fewer participants.";
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error finding best times: {ex.Message}");
            Console.WriteLine($"Stack trace: {ex.StackTrace}");
            errorMessage = $"Error analyzing availability: {ex.Message}";
        }
        finally
        {
            isFindingTimes = false;
            StateHasChanged();
        }
    }

    private void SelectSuggestion(SuggestedTimeSlot suggestion)
    {
        selectedSuggestion = suggestion;
        model.Date = suggestion.StartTime.Date;
        model.Time = TimeOnly.FromDateTime(suggestion.StartTime);
        timeString = model.Time.ToString("HH:mm");
        Console.WriteLine($"Selected suggestion: {suggestion.StartTime}");
    }

    private string GetAvailabilityBadgeClass(double score)
    {
        if (score >= 80) return "high";
        if (score >= 60) return "medium";
        return "low";
    }

    private async Task HandleCreate()
    {
        try
        {
            isSubmitting = true;
            errorMessage = "";
            
            UpdateModelTime();

            Console.WriteLine($"Creating meetup: {model.Title} on {model.Date:yyyy-MM-dd} at {timeString}");
            
            // Combine friends from individual selection and groups
            var allInvitedFriends = new HashSet<string>(selectedFriendIds);
            
            // Add members from selected groups
            foreach (var groupId in selectedGroupIds)
            {
                Console.WriteLine($"Getting members from group: {groupId}");
                var groupMemberIds = await GroupService.GetGroupMemberIdsAsync(groupId);
                foreach (var memberId in groupMemberIds)
                {
                    allInvitedFriends.Add(memberId);
                }
                Console.WriteLine($"  └─ Added {groupMemberIds.Count} members from group");
            }

            Console.WriteLine($"Total inviting {allInvitedFriends.Count} people ({selectedFriendIds.Count} individuals + members from {selectedGroupIds.Count} groups)");

            var success = await MeetupService.CreateMeetupAsync(model, allInvitedFriends.ToList());
            
            if (success)
            {
                Console.WriteLine("Meetup created successfully with invites!");
                Nav.NavigateTo("/meetups", forceLoad: false);
            }
            else
            {
                errorMessage = "Failed to create meetup. Please try again.";
                Console.WriteLine("Failed to create meetup");
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"An error occurred: {ex.Message}";
            Console.WriteLine($"Error creating meetup: {ex.Message}");
            Console.WriteLine($"Stack trace: {ex.StackTrace}");
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0) return "?";
        if (parts.Length == 1) return parts[0][0].ToString().ToUpper();
        return $"{parts[0][0]}{parts[^1][0]}".ToUpper();
    }

    private string GetGroupInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "G";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0) return "G";
        if (parts.Length == 1) return parts[0].Substring(0, Math.Min(2, parts[0].Length)).ToUpper();
        return $"{parts[0][0]}{parts[1][0]}".ToUpper();
    }
}