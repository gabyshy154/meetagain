@page "/meetups/{MeetupId}"
@inject MeetupService MeetupService
@inject MeetAgain.Server.Services.Mongo.MongoService MongoService
@inject AuthService Auth
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthStateProvider

<div class="max-w-4xl mx-auto">
    @if (loading)
    {
        <div class="loading-container">
            <div class="loading-spinner"></div>
            <p style="margin-top: 1rem; color: var(--gray-600);">Loading meetup…</p>
        </div>
    }
    else if (meetup == null)
    {
        <div class="card">
            <div class="empty-state">
                <div class="empty-state-icon">❌</div>
                <h3 class="empty-state-title">Meetup Not Found</h3>
                <p class="empty-state-description">
                    This meetup doesn't exist or you don't have permission to view it.
                </p>
                <a href="/meetups" class="btn btn-primary">Back to Meetups</a>
            </div>
        </div>
    }
    else
    {
        <div class="card fade-in">
            <div class="meetup-header">
                <div class="meetup-header-content">
                    <a href="/meetups" class="btn-back">← Back to Meetups</a>
                    <h1 class="meetup-detail-title">@meetup.Title</h1>

                    <div class="meetup-meta">
                        <span class="meta-item">📅 @meetup.EventDateTime.ToLocalTime().ToString("MMMM dd, yyyy")</span>
                        <span class="meta-item">🕐 @meetup.EventDateTime.ToLocalTime().ToString("h:mm tt")</span>
                        <span class="meta-badge">
                            @if (IsPast())
                            {
                                <span class="badge badge-gray">Past Event</span>
                            }
                            else if (IsToday())
                            {
                                <span class="badge badge-warning">Today</span>
                            }
                            else if (IsSoon())
                            {
                                <span class="badge badge-primary">Coming Soon</span>
                            }
                            else
                            {
                                <span class="badge badge-success">Upcoming</span>
                            }
                        </span>
                    </div>
                </div>

                @if (!IsPast())
                {
                    <div class="meetup-actions">
                        <a href="/meetups/@MeetupId/edit" class="btn btn-secondary">✏️ Edit</a>

                        <button type="button"
                                onclick="showDeleteModal()"
                                class="btn btn-danger-outline">
                            🗑️ Delete
                        </button>
                    </div>
                }
            </div>
        </div>

        <div class="card fade-in">
            <h2 class="section-title">Description</h2>
            <p class="meetup-description">@meetup.Description</p>
        </div>

        @if (!IsPast())
        {
            <div class="card fade-in countdown-card">
                <div class="countdown-content">
                    <div class="countdown-icon">⏰</div>
                    <div>
                        <h3 class="countdown-title">Time Until Meetup</h3>
                        <p class="countdown-time">@GetCountdown()</p>
                    </div>
                </div>
            </div>
        }

        <div class="card fade-in">
            <h2 class="section-title">Event Information</h2>
            <div class="info-grid">
                <div class="info-item">
                    <span class="info-label">Created</span>
                    <span class="info-value">@meetup.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy")</span>
                </div>

                <div class="info-item">
                    <span class="info-label">Event ID</span>
                    <span class="info-value">@meetup.Id.Substring(0, 8)…</span>
                </div>

                <div class="info-item">
                    <span class="info-label">Status</span>
                    <span class="info-value">
                        @if (IsPast())
                        {
                            @:Completed
                        }
                        else
                        {
                            @:Scheduled
                        }
                    </span>
                </div>
            </div>
        </div>
    }
</div>

<!-- Delete Confirmation Modal -->
<div class="modal-overlay" style="display: none;">
    <div class="modal-content">
        <h3 class="modal-title">Delete Meetup?</h3>

        <p class="modal-description">
            Are you sure you want to delete "<strong>@meetup?.Title</strong>"?
            This action cannot be undone.
        </p>

        <div class="modal-actions">
            <button type="button"
                    class="btn btn-outline"
                    onclick="hideDeleteModal()">
                Cancel
            </button>

            <button type="button"
                    class="btn btn-danger"
                    id="confirmDeleteBtn"
                    onclick="confirmDeleteMeetup('@MeetupId')">
                Delete Meetup
            </button>

        </div>
    </div>
</div>
<style>
    .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0, 0, 0, 0.5);
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 9999;
    }

    .modal-content {
        background: var(--surface);
        padding: 2rem;
        border-radius: var(--radius-lg, 12px);
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
        max-width: 500px;
        width: 90%;
    }

    .modal-title {
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--gray-900, #111);
        margin: 0 0 1rem 0;
    }

    .modal-description {
        color: var(--gray-600, #666);
        margin-bottom: 1.5rem;
        line-height: 1.6;
    }

    .modal-actions {
        display: flex;
        gap: 0.75rem;
        justify-content: flex-end;
    }

    /* ============================================
       MEETUP HEADER
       These classes had no definitions anywhere, so the back link rendered
       as a default underlined anchor, the badges had no pill or colour, and
       the meta row had no spacing.
       ============================================ */
    .meetup-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 1.5rem;
        flex-wrap: wrap;
    }

    .meetup-header-content {
        flex: 1;
        min-width: 0;
    }

    .btn-back {
        display: inline-block;
        color: var(--primary);
        text-decoration: none;
        font-weight: 600;
        font-size: 0.875rem;
        margin-bottom: 0.75rem;
    }

    .btn-back:hover {
        text-decoration: underline;
    }

    .meetup-detail-title {
        font-size: clamp(1.75rem, 4vw, 2.25rem);
        font-weight: 700;
        color: var(--gray-900);
        line-height: 1.2;
        margin-bottom: 0.75rem;
        overflow-wrap: anywhere;
    }

    .meetup-meta {
        display: flex;
        align-items: center;
        gap: 0.5rem 1.25rem;
        flex-wrap: wrap;
        font-size: 0.9375rem;
        color: var(--text-secondary);
    }

    .meta-item {
        display: inline-flex;
        align-items: center;
        gap: 0.375rem;
    }

    .meetup-actions {
        display: flex;
        gap: 0.75rem;
        align-items: center;
        flex-shrink: 0;
    }

    /* ============================================
       BODY SECTIONS
       ============================================ */
    .meetup-description {
        color: var(--gray-700);
        line-height: 1.7;
        white-space: pre-wrap;
        overflow-wrap: anywhere;
    }

    .countdown-card {
        background: var(--highlight);
        border-color: transparent;
    }

    .countdown-content {
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .countdown-icon {
        font-size: 2rem;
        line-height: 1;
        flex-shrink: 0;
    }

    .countdown-title {
        font-size: 1.125rem;
        font-weight: 700;
        color: var(--gray-900);
        margin-bottom: 0.25rem;
    }

    .countdown-time {
        font-size: 1.375rem;
        font-weight: 700;
        color: var(--primary);
    }

    .info-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 1.25rem;
    }

    .info-item {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }

    .info-label {
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--text-secondary);
    }

    .info-value {
        font-size: 1rem;
        font-weight: 600;
        color: var(--gray-900);
        overflow-wrap: anywhere;
    }

    @@media (max-width: 640px) {
        .meetup-header {
            flex-direction: column;
            gap: 1rem;
        }

        .meetup-actions {
            width: 100%;
        }

        .meetup-actions .btn {
            flex: 1;
        }
    }
</style>

@code {
    [Parameter] public string MeetupId { get; set; } = "";

    private Meetup? meetup;
    private bool loading = true;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var principal = authState.User;

        if (principal?.Identity?.IsAuthenticated != true)
        {
            Nav.NavigateTo("/login");
            return;
        }

        var uid = principal.FindFirst(c => c.Type == System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        Console.WriteLine($"MeetupDetail: user uid from claims = {uid}");

        try
        {
            meetup = await MongoService.GetMeetupByIdAsync(MeetupId);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"MeetupDetail: Error - {ex.Message}");
            meetup = null;
        }

        loading = false;
    }

    private bool IsPast() =>
        meetup?.EventDateTime.ToLocalTime() < DateTime.Now;

    private bool IsToday() =>
        meetup?.EventDateTime.ToLocalTime().Date == DateTime.Today;

    private bool IsSoon()
    {
        if (meetup == null) return false;
        var days = (meetup.EventDateTime.ToLocalTime() - DateTime.Now).TotalDays;
        return days >= 0 && days <= 7;
    }

    private string GetCountdown()
    {
        if (meetup == null) return "";
        var t = meetup.EventDateTime.ToLocalTime() - DateTime.Now;

        if (t.TotalDays >= 1) return $"{(int)t.TotalDays} days {t.Hours} hours";
        if (t.TotalHours >= 1) return $"{(int)t.TotalHours} hours {t.Minutes} minutes";
        if (t.TotalMinutes >= 1) return $"{(int)t.TotalMinutes} minutes";
        return "Starting soon!";
    }
}
